---
import { SectionSubheading } from '@/components/common/section-subheading';
import { BlurIn } from '@/components/animations/blur-in';
import ServicesCarousel from './ServicesCarousel';
---

<section id="services" class="lg:pt-36 lg:pb-32 pt-24 pb-16 relative overflow-hidden">
  <div class="container mx-auto px-4 text-center mb-12 sm:mb-16">
    <SectionSubheading client:visible text="Our Specialization" />
    <BlurIn client:visible delay={0.1}>
      <h2 class="font-medium md:text-5xl sm:text-4xl text-3xl mb-4 md:leading-14 sm:leading-11 leading-tight text-[var(--color-text)]">
        Engineering solutions built for scale
      </h2>
    </BlurIn>
    <p class="font-mono text-sm leading-6 font-light max-w-2xl mx-auto mt-4 text-[var(--color-text-muted)]">
      Robust, performant, and reliable capabilities built for modern distributed systems.
    </p>
  </div>

  <div class="flex justify-center overflow-hidden py-6">
    <ServicesCarousel client:visible={{ rootMargin: '200px' }} />
  </div>
</section>
