---
---

<section id="process" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative">
  <!-- Decorative gradient line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-400/30 to-transparent"></div>

  <!-- Heading -->
  <div class="mb-12 md:mb-20" data-aos="fade-up" data-aos-duration="800">
    <p class="text-secondary text-xs sm:text-sm font-medium uppercase tracking-widest mb-4">Our Methodology</p>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent">
      From Concept to Execution
    </h2>
  </div>

  <!-- Timeline wrapper -->
  <div class="relative">
    <!-- Animated connecting line (hidden on mobile) -->
    <svg class="hidden md:block absolute top-20 left-0 w-full h-24 pointer-events-none" viewBox="0 0 1200 100" preserveAspectRatio="xMidYMid meet">
      <line x1="0" y1="50" x2="1200" y2="50" stroke="url(#timelineGradient)" stroke-width="2" stroke-dasharray="5,5" class="animate-shimmer" opacity="0.6"/>
      <defs>
        <linearGradient id="timelineGradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" style="stop-color:rgba(6,182,212,0);stop-opacity:0" />
          <stop offset="50%" style="stop-color:#0f2a74;stop-opacity:1" />
          <stop offset="100%" style="stop-color:rgba(6,182,212,0);stop-opacity:0" />
        </linearGradient>
      </defs>
    </svg>

    <!-- Grid steps -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-6 md:gap-8 pt-8 md:pt-12 relative z-10">
      {[
        {
          icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`, // Magnifying glass - Discovery
          title: "Discovery",
          desc: "Business goals and technical needs analysis"
        },
        {
          icon: `<svg version="1.1" id="Uploaded to svgrepo.com" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 32 32" xml:space="preserve" stroke="currentColor" stroke-width="1.056"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <style type="text/css"> .feather_een{fill:#0B1719;} </style> <path class="feather_een" d="M29,4H3C1.343,4,0,5.343,0,7v16c0,1.657,1.343,3,3,3h9v3h-1.5c-0.276,0-0.5,0.224-0.5,0.5l0,0 c0,0.276,0.224,0.5,0.5,0.5h11c0.276,0,0.5-0.224,0.5-0.5l0,0c0-0.276-0.224-0.5-0.5-0.5H20v-3h9c1.657,0,3-1.343,3-3V7 C32,5.343,30.657,4,29,4z M19,29h-6v-3h6V29z M31,23c0,1.105-0.895,2-2,2H3c-1.105,0-2-0.895-2-2V7c0-1.105,0.895-2,2-2h26 c1.105,0,2,0.895,2,2V23z M25.805,9.03c-0.782-0.154-1.475,0.3-1.713,0.97H18V9h-4v1H7.908C7.67,9.33,6.976,8.876,6.195,9.03 c-0.573,0.113-1.04,0.572-1.16,1.144C4.83,11.145,5.565,12,6.5,12c0.652,0,1.202-0.419,1.408-1H14v0.224 c-4.388,0.897-7.745,4.658-7.986,9.246C5.999,20.757,6.227,21,6.515,21h0c0.263,0,0.484-0.204,0.497-0.467 c0.209-4.065,3.134-7.41,6.988-8.289V13h4v-0.757c3.854,0.88,6.779,4.225,6.988,8.289C25.002,20.796,25.222,21,25.485,21h0 c0.288,0,0.516-0.243,0.501-0.53c-0.241-4.588-3.598-8.349-7.986-9.246V11h6.092c0.207,0.581,0.756,1,1.408,1 c0.935,0,1.67-0.855,1.466-1.826C26.845,9.602,26.378,9.143,25.805,9.03z M6.5,11C6.224,11,6,10.776,6,10.5S6.224,10,6.5,10 S7,10.224,7,10.5S6.776,11,6.5,11z M17,12h-2v-2h2V12z M25.5,11c-0.276,0-0.5-0.224-0.5-0.5s0.224-0.5,0.5-0.5s0.5,0.224,0.5,0.5 S25.776,11,25.5,11z"></path> </g></svg>`, // Blueprint/layers vibe - Architecture
          title: "Design",
          desc: "System design and scalability planning"
        },
        {
          icon: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M7 8L3 11.6923L7 16M17 8L21 11.6923L17 16M14 4L10 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>`, // Code brackets - Development
          title: "Development",
          desc: "Clean, maintainable implementation"
        },
        {
          icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`, // Check/shield - Testing
          title: "Testing",
          desc: "Reliability and security validation"
        },
        {
          icon: `<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" fill="currentColor" ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <title>dev-ops-solid</title> <g id="Layer_2" data-name="Layer 2"> <g id="invisible_box" data-name="invisible box"> <rect width="48" height="48" fill="none"></rect> </g> <g id="icons_Q2" data-name="icons Q2"> <path d="M46,24A12,12,0,0,0,34,12c-5.2,0-9.5,4.1-11.9,11.4C20.3,28.9,17.3,32,14,32a8,8,0,0,1,0-16h1.2l-1.6,1.6a1.9,1.9,0,0,0,.2,3,2.1,2.1,0,0,0,2.7-.2l4.9-5a1.9,1.9,0,0,0,0-2.8l-4.9-5a2.1,2.1,0,0,0-2.7-.2,1.9,1.9,0,0,0-.2,3L15.2,12H14a12,12,0,0,0,0,24c5.2,0,9.5-4.1,11.9-11.4C27.7,19.1,30.7,16,34,16a8,8,0,0,1,0,16H32.8l1.6-1.6a1.9,1.9,0,0,0-.2-3,2.1,2.1,0,0,0-2.7.2l-4.9,5a1.9,1.9,0,0,0,0,2.8l4.9,5a2.1,2.1,0,0,0,2.7.2,1.9,1.9,0,0,0,.2-3L32.8,36H34A12,12,0,0,0,46,24Z"></path> </g> </g> </g></svg>`, // Rocket/upload arrow - Deployment
          title: "Deployment & Support",
          desc: "Stable release and long-term maintenance"
        }
      ].map((step, idx) => (
        <div 
          class="group text-center transform transition-all duration-500 hover:scale-110"
          data-aos="fade-up"
          data-aos-duration="600"
          data-aos-delay={`${idx * 100}`}
        >
          <!-- Glowing icon circle -->
          <div class="relative mb-4 sm:mb-6 inline-block">
            <div class="absolute inset-0 bg-gradient-to-br from-secondary/30 to-blue-500/20 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            
            <!-- Circle with icon -->
            <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-gradient-to-br from-slate-100 to-slate-50 border-2 border-slate-200 group-hover:border-secondary group-hover:shadow-lg group-hover:shadow-secondary/50 flex items-center justify-center transition-all duration-300 transform group-hover:scale-125">
              <div 
                class="w-10 h-10 sm:w-12 sm:h-12 text-slate-500 group-hover:text-secondary transition-colors duration-300"
                set:html={step.icon}
              ></div>
            </div>
          </div>
          
          <h3 class="font-semibold text-lg sm:text-xl mb-2 sm:mb-3 text-slate-900 group-hover:text-secondary transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            {step.desc}
          </p>

          <!-- Animated check mark on hover -->
          <div class="mt-4 sm:mt-6 h-6 flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-0 group-hover:scale-100 transition-all duration-500">
            <svg class="w-6 h-6 text-secondary animate-pulse" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    0% { stroke-dashoffset: 10; }
    100% { stroke-dashoffset: 0; }
  }

  .animate-shimmer {
    animation: shimmer 3s linear infinite;
  }
</style>