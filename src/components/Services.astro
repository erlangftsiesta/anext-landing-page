---
---

<section id="services" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 relative">
  <!-- Decorative gradient line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-400/30 to-transparent"></div>

  <div class="mb-20 animate-fadeInUp">
    <div class="inline-block">
      <p class="text-cyan-500 text-sm font-medium uppercase tracking-widest mb-4">Our Expertise</p>
    </div>
    <h2 class="text-5xl mb-6 font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent">
      What we specialize in
    </h2>
    <p class="text-xl text-slate-900 max-w-2xl">
      Engineering solutions built for performance, security, and scale.
    </p>
  </div>

  <div class="grid md:grid-cols-2 gap-12 lg:gap-16">
    {[
      { title: "Website & Web Systems", desc: "Custom websites, dashboards, and internal tools.", icon: "🌐" },
      { title: "Aplikasi (Mobile & Web)", desc: "Scalable mobile and web applications.", icon: "📱" },
      { title: "Cyber Security Analyst & Pentest", desc: "Security assessment, penetration testing, and mitigation.", icon: "🔒" },
      { title: "IoT Solutions", desc: "Device integration, telemetry, and data pipelines.", icon: "🔌" },
      { title: "Pengadaan Server & Infrastruktur", desc: "Server planning, setup, and optimization.", icon: "🏗️" },
      { title: "IT & Technical Consulting", desc: "Architecture review and long-term IT strategy.", icon: "💼" }
    ].map((service, idx) => (
      <div 
        class="group relative p-8 rounded-2xl border border-slate-200 hover:border-cyan-400/50 transition-all duration-500 transform hover:scale-105 hover:shadow-2xl overflow-hidden"
        style={`animation: fadeInUp 0.8s ease-out ${idx * 0.1}s both`}
      >
        <!-- Animated background gradient -->
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-50/0 to-cyan-100/0 group-hover:from-cyan-50/50 group-hover:to-cyan-100/30 transition-all duration-500"></div>
        
        <!-- Border glow on hover -->
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-2xl shadow-cyan-400/20"></div>

        <div class="relative z-10 space-y-4">
          <div class="text-4xl mb-4 transform group-hover:scale-125 transition-transform duration-300">{service.icon}</div>
          
          <h3 class="text-2xl font-semibold text-slate-900 group-hover:text-cyan-600 transition-colors duration-300">
            {service.title}
          </h3>
          
          <p class="text-slate-600 text-lg leading-relaxed">
            {service.desc}
          </p>

          <!-- Animated arrow -->
          <div class="pt-4 inline-flex items-center gap-2 text-cyan-500 font-medium opacity-0 group-hover:opacity-100 transform group-hover:translate-x-2 transition-all duration-300">
            Learn more
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
