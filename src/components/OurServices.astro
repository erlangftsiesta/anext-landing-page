---

<section id="services" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative">
  <!-- Decorative gradient line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/40 to-transparent"></div>

  <!-- Heading -->
  <div class="mb-12 md:mb-20" data-aos="fade-up" data-aos-duration="800">
    <div class="inline-block">
      <p
        class="text-xs esm:text-sm font-medium uppercase tracking-widest mb-4
               bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent"
      >
        Our Services
      </p>
    </div>

    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 md:mb-6 text-secondary text-balance">
      What we specialize in
    </h2>

    <p class="text-base sm:text-lg md:text-xl text-slate-600 max-w-2xl">
      Engineering solutions built for performance, security, and scale.
    </p>
  </div>

  <!-- Services grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 relative z-10 gap-4 sm:gap-5 md:gap-6 py-8 md:py-10">
    {[
      { title: "Developer Outsourcing", desc: "Get access to trusted developers who integrate seamlessly with your projects, helping you scale quickly with high-quality results.", icon: `<svg viewBox="0 0 1024 1024" fill="#000000" class="icon" version="1.1" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M962.4 1012.8s0 0.8 0 0h25.6-25.6zM704 338.4C704 195.2 588.8 78.4 445.6 78.4S187.2 195.2 187.2 338.4s116 260 258.4 260S704 481.6 704 338.4z m-472 0c0-118.4 96-214.4 213.6-214.4s213.6 96 213.6 214.4-96 214.4-213.6 214.4S232 456.8 232 338.4z" fill=""></path><path d="M456.8 621.6c196.8 0 361.6 136 394.4 324h45.6C863.2 732 677.6 576.8 456 576.8c-221.6 0-406.4 155.2-440.8 368.8h45.6C96 756.8 260 621.6 456.8 621.6z" fill=""></path><path d="M770.4 578.4l-24-8.8 20.8-14.4c65.6-46.4 104.8-122.4 103.2-202.4-1.6-128-102.4-232.8-228-241.6v47.2c100 8.8 180 92.8 180.8 194.4 0.8 52.8-19.2 102.4-56 140.8-36.8 37.6-86.4 59.2-139.2 60-24.8 0-50.4 0-75.2 1.6-15.2 1.6-41.6 0-54.4 9.6-1.6 0.8-3.2 0-4.8 0l-9.6 12c-0.8 1.6-2.4 3.2-4 4.8 0.8 1.6-0.8 16 0 17.6 12 4 71.2 0 156.8 2.4 179.2 1.6 326.4 160.8 340.8 338.4l47.2 3.2c-9.6-156-108-310.4-254.4-364.8z" fill=""></path></g></svg>` },
