---
// src/pages/team.astro
import 'aos/dist/aos.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Team - ANEXT</title>
</head>
<body>
  
  <!-- Team Section -->
  <section class="mt-8 min-h-screen py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      

      
      <!-- Team Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
        
        <!-- Member 1 -->
        <div class="group cursor-pointer" data-aos="fade-up" data-aos-delay="100">
          <div class="relative overflow-hidden rounded-2xl">
            <img 
              src="https://api.dicebear.com/7.x/avataaars/svg?seed=Alex" 
              alt="Alex Chen" 
              class="w-full grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105"
            >
            <div class="absolute inset-0 bg-purple-500/0 group-hover:bg-purple-500/10 transition-all duration-500"></div>
          </div>
          <p class="text-center mt-4 font-semibold text-gray-900 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            Alex Chen
          </p>
        </div>
        
        <!-- Member 2 - Offset -->
        <div class="group cursor-pointer md:mt-12" data-aos="fade-up" data-aos-delay="200">
