---
import 'aos/dist/aos.css';
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative">
  <!-- Decorative gradient line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-400/30 to-transparent"></div>

  <div class="max-w-4xl mx-auto text-center">
    
    <!-- Small label -->
    <div class="inline-block mb-6" data-aos="fade-up" data-aos-duration="600">
      <p class="text-base sm:text-lg md:text-xl text-slate-900 font-bold max-w-2xl">
        The People Behind ANEXT
      </p>
    </div>

    <!-- Main heading -->
    <h2 
      class="text-3xl sm:text-4xl md:text-5xl font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent"
      data-aos="fade-up" 
      data-aos-duration="800"
      data-aos-delay="100"
    >
      Every great system is built by great people
    </h2>

    <!-- Description -->
    <p 
      class="mt-4 text-base sm:text-lg md:text-xl text-slate-600 mb-8 md:mb-10 max-w-2xl mx-auto leading-relaxed"
      data-aos="fade-up" 
      data-aos-duration="800"
      data-aos-delay="200"
    >
      We're a team of engineers, designers, and problem-solvers who believe in building things that last. 
      Each person brings unique expertise, but we all share one goal: creating reliable systems you can trust.
    </p>

    <!-- Stats row -->
    <div 
      class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 pt-8 md:pt-12 border-t border-slate-200"
      data-aos="fade-up" 
      data-aos-duration="800"
      data-aos-delay="300"
    >
      <!-- Stat 1 -->
      <div class="text-center group">
        <div class="text-3xl md:text-4xl font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent mb-2 transform group-hover:scale-110 transition-transform duration-300">
          12+
        </div>
        <p class="text-sm text-slate-600 font-medium">Partnership</p>
      </div>

      <!-- Stat 2 -->
      <div class="text-center group">
        <div class="text-3xl md:text-4xl font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent mb-2 transform group-hover:scale-110 transition-transform duration-300">
          50+
        </div>
        <p class="text-sm text-slate-600 font-medium">Projects Delivered</p>
      </div>

      <!-- Stat 3 -->
      <div class="text-center group">
        <div class="text-3xl md:text-4xl font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent mb-2 transform group-hover:scale-110 transition-transform duration-300">
          5+
        </div>
        <p class="text-sm text-slate-600 font-medium">Years Experience</p>
      </div>

      <!-- Stat 4 -->
      <div class="text-center group">
        <div class="text-3xl md:text-4xl font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent mb-2 transform group-hover:scale-110 transition-transform duration-300">
          24/7
        </div>
        <p class="text-sm text-slate-600 font-medium">Support Available</p>
      </div>
    </div>

  </div>
</section>

<!-- Portfolio Showcase with Lenis Parallax -->
<section class="py-16 md:py-24 overflow-hidden bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 md:mb-16">
    <div class="text-center max-w-2xl mx-auto" data-aos="fade-up" data-aos-duration="800">
      <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent mb-4">
        Built by this team
      </h3>
      <p class="text-slate-600 text-base md:text-lg">
        Real products, real impact. Here's what we've shipped together.
      </p>
    </div>
  </div>

  <!-- Parallax Grid Container -->
  <div id="parallax-grid" class="hidden lg:grid lg:grid-cols-7 gap-6 px-4 max-w-[1400px] mx-auto">
    
    <!-- Grid Items - Each will get random parallax -->
    <div class="parallax-item" data-parallax-item data-aos="fade-up" data-aos-duration="600">
      <img 
        src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=400&h=800&fit=crop" 
        alt="Project 1" 
        class="w-full h-auto shadow-lg hover:shadow-xl transition-shadow duration-300"
        loading="lazy"
      />
    </div>

    <div class="parallax-item" data-parallax-item data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
      <img 
        src="https://images.unsplash.com/photo-1551650975-87deedd944c3?w=400&h=800&fit=crop" 
        alt="Project 2" 
        class="w-full h-auto shadow-lg hover:shadow-xl transition-shadow duration-300"
        loading="lazy"
      />
    </div>

    <div class="parallax-item" data-parallax-item data-aos="fade-up" data-aos-duration="600" data-aos-delay="200">
      <img 
        src="https://images.unsplash.com/photo-1555421689-d68471e189f2?w=400&h=800&fit=crop" 
        alt="Project 3" 
        class="w-full h-auto shadow-lg hover:shadow-xl transition-shadow duration-300"
        loading="lazy"
      />
    </div>

    <div class="parallax-item" data-parallax-item data-aos="fade-up" data-aos-duration="600" data-aos-delay="300">
      <img 
        src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=400&h=800&fit=crop" 
        alt="Project 4" 
        class="w-full h-auto shadow-lg hover:shadow-xl transition-shadow duration-300"
        loading="lazy"
      />
    </div>

    <div class="parallax-item" data-parallax-item data-aos="fade-up" data-aos-duration="600" data-aos-delay="400">
      <img 
        src="https://images.unsplash.com/photo-1547658719-da2b51169166?w=400&h=800&fit=crop" 
        alt="Project 5" 
        class="w-full h-auto shadow-lg hover:shadow-xl transition-shadow duration-300"
        loading="lazy"
      />
    </div>

    <div class="parallax-item" data-parallax-item data-aos="fade-up" data-aos-duration="600" data-aos-delay="500">
      <img 
        src="https://images.unsplash.com/photo-1551650975-87deedd944c3?w=400&h=800&fit=crop" 
        alt="Project 6" 
        class="w-full h-auto shadow-lg hover:shadow-xl transition-shadow duration-300"
        loading="lazy"
      />
    </div>

    <div class="parallax-item" data-parallax-item data-aos="fade-up" data-aos-duration="600" data-aos-delay="600">
      <img 
        src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=400&h=800&fit=crop" 
        alt="Project 7" 
        class="w-full h-auto shadow-lg hover:shadow-xl transition-shadow duration-300"
        loading="lazy"
      />
    </div>

  </div>

  <!-- Mobile Grid (Simple, No Parallax) -->
  <div class="lg:hidden grid grid-cols-2 md:grid-cols-3 gap-4 px-4">
    <div data-aos="fade-up" data-aos-duration="600">
      <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=400&h=600&fit=crop" alt="Project 1" class="w-full shadow-md hover:shadow-lg transition-shadow duration-300" />
    </div>
    <div data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
      <img src="https://images.unsplash.com/photo-1551650975-87deedd944c3?w=400&h=600&fit=crop" alt="Project 2" class="w-full shadow-md hover:shadow-lg transition-shadow duration-300" />
    </div>
    <div data-aos="fade-up" data-aos-duration="600" data-aos-delay="200">
      <img src="https://images.unsplash.com/photo-1555421689-d68471e189f2?w=400&h=600&fit=crop" alt="Project 3" class="w-full shadow-md hover:shadow-lg transition-shadow duration-300" />
    </div>
    <div data-aos="fade-up" data-aos-duration="600" data-aos-delay="300">
      <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=400&h=600&fit=crop" alt="Project 4" class="w-full shadow-md hover:shadow-lg transition-shadow duration-300" />
    </div>
    <div data-aos="fade-up" data-aos-duration="600" data-aos-delay="400">
      <img src="https://images.unsplash.com/photo-1547658719-da2b51169166?w=400&h=600&fit=crop" alt="Project 5" class="w-full shadow-md hover:shadow-lg transition-shadow duration-300" />
    </div>
    <div data-aos="fade-up" data-aos-duration="600" data-aos-delay="500">
      <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=400&h=600&fit=crop" alt="Project 6" class="w-full shadow-md hover:shadow-lg transition-shadow duration-300" />
    </div>
  </div>
</section>

<script>
  import AOS from 'aos';
  import Lenis from '@studio-freight/lenis';

  // Initialize AOS
  AOS.init({
    duration: 800,
    easing: 'ease-out',
    once: true,
    offset: 100
  });

  // Initialize Lenis Smooth Scroll
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    wheelMultiplier: 1,
    touchMultiplier: 2,
  });

  // Request Animation Frame for Lenis (optimized)
  function raf(time: number) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);

  // Parallax Grid Setup
  const parallaxItems = document.querySelectorAll('[data-parallax-item]');
  const gridSection = document.getElementById('parallax-grid');
  
  if (gridSection && parallaxItems.length > 0) {
    // Generate random INITIAL offsets for each item (applied once at start)
    const parallaxData = Array.from(parallaxItems).map(() => ({
      initialY: (Math.random() - 0.5) * 200,
      initialX: (Math.random() - 0.5) * 100,
      initialRotate: (Math.random() - 0.5) * 4
    }));

    // Apply initial scattered position
    parallaxItems.forEach((item, index) => {
      const data = parallaxData[index];
      (item as HTMLElement).style.transform = `
        translate3d(${data.initialX}px, ${data.initialY}px, 0) 
        rotate(${data.initialRotate}deg)
      `;
    });

    // Cache section measurements
    let sectionTop = 0;
    let sectionHeight = 0;
    
    const updateSectionMeasurements = () => {
      const rect = gridSection.getBoundingClientRect();
      sectionTop = window.scrollY + rect.top;
      sectionHeight = rect.height;
    };
    
    updateSectionMeasurements();
    window.addEventListener('resize', updateSectionMeasurements);

    // Optimized scroll handler
    let ticking = false;
    
    const updateParallax = (scroll: number) => {
      const scrollProgress = (scroll - sectionTop + window.innerHeight * 0.5) / (sectionHeight * 0.5);
      const progress = Math.max(0, Math.min(1, scrollProgress));
      
      parallaxItems.forEach((item, index) => {
        const data = parallaxData[index];
        
        const yPos = data.initialY * (1 - progress);
        const xPos = data.initialX * (1 - progress);
        const rotation = data.initialRotate * (1 - progress);

        (item as HTMLElement).style.transform = `
          translate3d(${xPos}px, ${yPos}px, 0) 
          rotate(${rotation}deg)
        `;
      });
      
      ticking = false;
    };

    lenis.on('scroll', ({ scroll }: { scroll: number }) => {
      if (!ticking) {
        requestAnimationFrame(() => updateParallax(scroll));
        ticking = true;
      }
    });
  }
</script>

<style>
  .parallax-item {
    will-change: transform;
    transform: translate3d(0, 0, 0);
    transition: transform 0.1s ease-out;
  }
</style>
