---
---

<section id="technology" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative">

  <!-- Decorative gradient line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--secondary)]/40 to-transparent"></div>

  <!-- Section header -->
  <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16" data-aos="fade-up">
    <div class="inline-block px-4 sm:px-6 py-1.5 sm:py-2 text-xs sm:text-sm font-medium rounded-full bg-[var(--secondary)]/10 text-[var(--secondary)] mb-4">
      Cutting-Edge Technology
    </div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 md:mb-6 bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent">
      Built With The Best Practice & Tools In The Industry
    </h2>
    <p class="text-base sm:text-lg md:text-xl text-slate-600">
      Our platform leverages modern technologies to deliver exceptional performance, reliability, and user experience.
    </p>
  </div>

  <!-- Categories -->
  <div class="space-y-16 md:space-y-20">

    {[
      {
        name: "Frontend",
        description: "Creating beautiful, responsive user interfaces that delight your customers.",
        techs: [
          { name: "Tailwind CSS", logo: "https://tailwindcss.com/_next/static/media/tailwindcss-mark.d52e9897.svg" },
          { name: "React", logo: "https://www.pngall.com/wp-content/uploads/15/React-Logo-PNG-Images.png" },
          { name: "Shadcn UI", logo: "https://svgstack.com/media/img/shadcn-logo-Gbcc001271.webp" },
          { name: "Gatsby", logo: "https://vectorseek.com/wp-content/uploads/2023/08/Gatsby-Logo-Vector.svg-.png" },
          { name: "Next.js", logo: "https://iconape.com/wp-content/png_logo_vector/next-js-logo.png" },
          { name: "Svelte", logo: "https://openexpoeurope.com/wp-content/uploads/2019/09/svelte-logo.png" },
          { name: "Astro", logo: "https://images.seeklogo.com/logo-png/47/3/astro-logo-png_seeklogo-477951.png" },
          { name: "Progressive Web Application", logo: "https://creazilla-store.fra1.digitaloceanspaces.com/icons/3205003/logo-pwa-icon-md.png" },
          // Tambah ShadcnUI / ChakraUI kalau mau, bisa cari logo masing-masing
        ]
      },
      {
        name: "Backend",
        description: "Building robust, scalable server-side applications with enterprise-grade reliability.",
        techs: [
          { name: "Golang", logo: "https://images.icon-icons.com/2699/PNG/512/golang_logo_icon_171073.png" },
          { name: "NestJS", logo: "https://images.icon-icons.com/2699/PNG/512/nestjs_logo_icon_169927.png" },
          { name: "Laravel", logo: "https://tse3.mm.bing.net/th/id/OIP.Hh_tEbIb4-MagJsV6x_RZwHaHa?rs=1&pid=ImgDetMain&o=7&rm=3" }, // Optional, kalau mau tambah
          { name: ".Net", logo: "https://images.macrumors.com/t/X0uSmVL9RrgLG4kyGSMAxMJBZRc=/400x0/article-new/2014/11/Microsoft-dotNET-logo.png?lossy" }, // Optional, kalau mau tambah
          // Tambah lainnya sesuai kebutuhan
        ]
      },
      {
        name: "Infrastructure & DevOps",
        description: "Modern cloud infrastructure and deployment strategies for seamless scaling.",
        techs: [
          { name: "Docker", logo: "https://logos-world.net/wp-content/uploads/2021/02/Docker-Emblem.png" },
          { name: "Kubernetes", logo: "https://download.logo.wine/logo/Kubernetes/Kubernetes-Logo.wine.png" },
          { name: "AWS", logo: "https://upload.wikimedia.org/wikipedia/commons/9/93/Amazon_Web_Services_Logo.svg" }, // SVG official
          { name: "On Premise Server", logo: "/images/tech-stack/OnPremiseServer.png" },
          { name: "Google Cloud Platform", logo: "https://download.logo.wine/logo/Google_Cloud_Platform/Google_Cloud_Platform-Logo.wine.png" },
          { name: "Jenkins", logo: "https://logos-world.net/wp-content/uploads/2023/12/Jenkins-Logo.png" },
          { name: "Proxmox", logo: "https://cdn.brandfetch.io/idYhArbU8H/w/400/h/60/theme/dark/logo.png?c=1bxid64Mup7aczewSAYMX&t=1751077538626" },
          { name: "Mikrotik", logo: "https://vectorseek.com/wp-content/uploads/2023/09/Mikrotik-Logo-Vector.svg-.png" },
          // Tambah GCP / GitHub Actions kalau perlu
        ]
      },
      {
        name: "Database & Tools",
        description: "Enterprise-grade data management and development tools for optimal performance.",
        techs: [
          { name: "PostgreSQL", logo: "https://cdn.freebiesupply.com/logos/thumbs/2x/postgresql-logo.png" },
          { name: "MongoDB", logo: "https://1000logos.net/wp-content/uploads/2020/08/MongoDB-Logo.png" },
          { name: "Redis", logo: "https://download.logo.wine/logo/Redis/Redis-Logo.wine.png" },
          { name: "Minio Object Storage", logo: "https://cdn.freelogovectors.net/wp-content/uploads/2020/11/minio-logo.png" },
          // Tambah Supabase / Firebase dll
        ]
      }
    ].map((category, catIdx) => (
      <div class="space-y-6 md:space-y-8 mb-8" data-aos="fade-up" data-aos-delay={`${catIdx * 100}`}>

        <!-- Category header -->
        <div class="space-y-2 md:space-y-3">
          <h3 class="text-xl sm:text-2xl md:text-3xl font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent">
            {category.name}
          </h3>
          <p class="text-sm sm:text-base md:text-lg text-slate-600 max-w-2xl">
            {category.description}
          </p>
        </div>

        <!-- Tech grid with images -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">

          {category.techs.map((tech, techIdx) => (
            <div
              class="group relative overflow-hidden rounded-xl border-2 border-slate-200/70 bg-white/50 backdrop-blur-sm
                     hover:border-[var(--secondary)] hover:shadow-xl hover:shadow-[var(--secondary)]/30
                     transition-all duration-400 transform hover:scale-105 hover:-translate-y-2
                     cursor-pointer aspect-square flex flex-col items-center justify-center p-4 md:p-6"
              data-aos="fade-up"
              data-aos-delay={`${(catIdx * 100) + (techIdx * 40)}`}
            >

              <!-- Hover gradient overlay -->
              <div class="absolute inset-0 bg-gradient-to-br from-[var(--secondary)]/0 to-[var(--accent)]/0 
                           group-hover:from-[var(--secondary)]/10 group-hover:to-[var(--accent)]/10 
                           transition-all duration-400"></div>

              <!-- Logo Image -->
              <img 
                src={tech.logo} 
                alt={`${tech.name} logo`}
                class="w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 object-contain relative z-10 
                       transition-transform duration-400 group-hover:scale-110 group-hover:rotate-3"
                loading="lazy"
                decoding="async"
              />

              <!-- Tech name below image -->
              <span class="mt-3 md:mt-4 block text-xs sm:text-sm font-semibold text-slate-800 
                           group-hover:text-[var(--secondary)] transition-colors duration-300 relative z-10 text-center">
                {tech.name}
              </span>

              <!-- Top accent bar on hover -->
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[var(--secondary)] to-transparent 
                           scale-x-0 group-hover:scale-x-100 transition-transform duration-400 origin-center"></div>

            </div>
          ))}

        </div>
      </div>
    ))}

  </div>

  <!-- Decorative bottom glow -->
  <div class="absolute bottom-0 left-1/4 right-1/4 h-32 bg-gradient-to-t from-[var(--secondary)]/10 to-transparent blur-3xl pointer-events-none"></div>

</section>