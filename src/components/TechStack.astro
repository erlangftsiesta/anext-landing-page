---
---
<section id="technology" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative">

  <!-- Decorative gradient line -->
  <div
    class="absolute top-0 left-0 right-0 h-px
    bg-gradient-to-r from-transparent via-[var(--secondary)]/40 to-transparent">
  </div>

  <!-- Section header -->
  <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16" data-aos="fade-up">

    <div
      class="inline-block px-4 sm:px-6 py-1.5 sm:py-2 text-xs sm:text-sm font-medium rounded-full
      bg-[var(--secondary)]/10 text-[var(--secondary)] mb-4">
      Cutting-Edge Technology
    </div>

    <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 md:mb-6 font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent">
      Built With The Best Tools In The Industry
    </h2>

    <p class="text-base sm:text-lg md:text-xl text-slate-600">
      Our platform leverages modern technologies to deliver exceptional performance, reliability, and user experience.
    </p>
  </div>

  <!-- Categories -->
  <div class="space-y-16 md:space-y-20">

    {[
      {
        name: "Frontend",
        description: "Creating beautiful, responsive user interfaces that delight your customers.",
        techs: ["React", "Svelte", "Next.js", "Astro", "TypeScript", "Tailwind CSS", "ShadcnUI", "ChakraUI"]
      },
      {
        name: "Backend",
        description: "Building robust, scalable server-side applications with enterprise-grade reliability.",
        techs: ["Golang", "NestJS", "Express", "Fastify", ".Net", "GraphQL", "REST APIs", "Microservices"]
      },
      {
        name: "Infrastructure & DevOps",
        description: "Modern cloud infrastructure and deployment strategies for seamless scaling.",
        techs: ["Docker", "Kubernetes", "AWS", "GCP", "Vercel", "GitHub Actions", "On Premise Server", "CI/CD Pipelines"]
      },
      {
        name: "Database & Tools",
        description: "Enterprise-grade data management and development tools for optimal performance.",
        techs: ["PostgreSQL", "MongoDB", "Redis", "Supabase", "Firebase", "TypeORM", "Message Queues", "MQTT"]
      }
    ].map((category, catIdx) => (
      <div class="space-y-6 md:space-y-8 mb-8" data-aos="fade-up" data-aos-delay={`${catIdx * 100}`}>

        <!-- Category header -->
        <div class="space-y-2 md:space-y-3">
          <h3 class="text-xl sm:text-2xl md:text-3xl font-bold font-bold bg-gradient-to-b from-primary to-secondary bg-clip-text text-transparent">
            {category.name}
          </h3>
          <p class="text-sm sm:text-base md:text-lg text-slate-600 max-w-2xl">
            {category.description}
          </p>
        </div>

        <!-- Tech grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3 md:gap-4">

          {category.techs.map((tech, techIdx) => (
            <div
              class="group relative overflow-hidden rounded-lg sm:rounded-xl
              border-2 border-slate-200 bg-white
              hover:border-[var(--secondary)]
              hover:shadow-lg hover:shadow-[var(--secondary)]/30
              transition-all duration-300 transform hover:scale-105 hover:-translate-y-1
              cursor-pointer p-3 sm:p-4 md:p-6 text-center"
              data-aos="fade-up"
              data-aos-delay={`${(catIdx * 100) + (techIdx * 30)}`}
            >

              <!-- Hover gradient bg -->
              <div
                class="absolute inset-0 bg-gradient-to-br
                from-[var(--secondary)]/0 to-[var(--accent)]/0
                group-hover:from-[var(--secondary)]/12
                group-hover:to-[var(--accent)]/12
                transition-all duration-300">
              </div>

              <!-- Glow -->
              <div
                class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300
                rounded-xl shadow-xl shadow-[var(--secondary)]/20">
              </div>

              <!-- Tech name -->
              <span
                class="relative z-10 block text-xs sm:text-sm font-semibold text-[var(--primary)]
                group-hover:text-[var(--secondary)] transition-colors text-balance">
                {tech}
              </span>

              <!-- Top accent bar -->
              <div
                class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r
                from-transparent via-[var(--secondary)] to-transparent
                scale-x-0 group-hover:scale-x-100
                transition-transform duration-300 origin-center">
              </div>

            </div>
          ))}

        </div>
      </div>
    ))}

  </div>

  <!-- Decorative bottom glow -->
  <div
    class="absolute bottom-0 left-1/4 right-1/4 h-32
    bg-gradient-to-t from-[var(--secondary)]/10 to-transparent
    blur-3xl pointer-events-none">
  </div>

</section>
