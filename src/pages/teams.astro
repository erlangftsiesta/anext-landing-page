---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroIsland from '@/components/sections/hero/HeroIsland';
import Footer from '@/components/sections/footer/Footer.astro';

const teamMembers = [
  {
    name: "Nadhin Galuh Ekania W.",
    role: "General Manager",
    bio: "Oversees company operations, team coordination, and strategic execution to ensure organizational goals are achieved efficiently.",
    image: "/images/teams/nadhin_galuh.png",
    hue: 222
  },
  {
    name: "Erlangga Muhamad Hafiz",
    role: "President Director",
    bio: "Leading company vision, innovation strategy, and long-term growth of ANEXT through technology and digital transformation.",
    image: "/images/teams/erlangga_muhamad.png",
    hue: 262
  },
  {
    name: "Ratu Natifha Alena",
    role: "Head of Finance",
    bio: "Manages financial planning, budgeting, and reporting to maintain the company’s financial stability and sustainable growth.",
    image: "/images/teams/ratu_natifha.png",
    hue: 172
  },
  {
    name: "Ichwan Nur Fitrah",
    role: "Senior Software Engineer",
    bio: "Designs and develops scalable software systems while mentoring developers and ensuring high engineering standards.",
    image: "/images/teams/ichwan_nur.png",
    hue: 200
  },
  {
    name: "Aditya Kurnia",
    role: "Fullstack Engineer",
    bio: "Builds and maintains both frontend and backend systems to deliver reliable and high-performance web applications.",
    image: "/images/teams/aditya_kurnia.png",
    hue: 150
  },
  {
    name: "Farhan Aditya",
    role: "UI/UX & QA",
    bio: "Ensures intuitive user experiences while maintaining product quality through testing, usability evaluation, and design improvements.",
    image: "/images/teams/farhan_aditya.png",
    hue: 305
  },
  {
    name: "Wysis Hero",
    role: "Marketing",
    bio: "Develops marketing strategies and campaigns to expand brand awareness and connect ANEXT with a wider audience.",
    image: "/images/teams/wysis_hero.png",
    hue: 215
  },
  {
    name: "Muhamad Satria Mandala",
    role: "Content Editor",
    bio: "Creates and refines digital content to communicate the company’s message clearly across multiple platforms.",
    image: "/images/teams/muhamad_satria.png",
    hue: 280
  },
  {
    name: "Muhamad Arridho",
    role: "Social Media Admin",
    bio: "Manages social media platforms, engages with the audience, and ensures consistent brand presence online.",
    image: "/images/teams/muhammad_arridho.png",
    hue: 190
  }
];
---

<MainLayout 
  title="Our Team - ANEXT" 
  description="Meet the engineers, designers, and innovators behind ANEXT engineering solutions."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Our Team - ANEXT",
    "url": "https://anext.dev/teams",
    "description": "Meet the engineers, designers, and innovators behind ANEXT engineering solutions.",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": teamMembers.map((m, idx) => ({
        "@type": "Person",
        "position": idx + 1,
        "name": m.name,
        "jobTitle": m.role,
        "description": m.bio,
        "image": `https://anext.dev${m.image}`
      }))
    }
  })} />
  <main id="main-content" class="w-full relative overflow-x-clip transition-colors duration-300">
    <!-- Navbar from HeroIsland -->
    <HeroIsland client:load variant="menu" floating={false} />

    <!-- Fullscreen Interactive Team Experience -->
    <section class="team-track" id="team" aria-labelledby="team-title">
      <div class="stage" id="team-stage">
        <!-- Dynamic Aurora Glow -->
        <div class="stage-glow" id="glow"></div>
        <div class="stage-grain"></div>
        <div class="stage-ghost select-none" id="ghost" aria-hidden="true">This is Ours! This is Ours! This is Ours!</div>

        <!-- Intro layer (Unfolds on initial scroll) -->
        <div class="intro" id="intro">
          <div class="intro-headline">
            <p class="eyebrow font-mono" id="eyebrow">
              <i class="eyebrow-line"></i>
              <span>The People Behind ANEXT</span>
            </p>
            <h1 class="title font-sans" id="team-title">
              <span class="m"><span class="w">Every</span></span>{" "}
              <span class="m"><span class="w">great</span></span>{" "}
              <span class="m"><span class="w">system</span></span>{" "}
              <span class="m"><span class="w">is</span></span>{" "}
              <span class="m"><span class="w">built</span></span>{" "}
              <span class="m"><span class="w">by</span></span>{" "}
              <span class="m"><span class="w">great</span></span>{" "}
              <span class="m"><span class="w">people</span></span>
            </h1>
          </div>
          <div class="side">
            <p id="lede" class="font-sans leading-relaxed text-muted">
              We're a team of engineers, designers, and problem-solvers who believe in building things that last. Each person brings unique expertise, but we all share one goal: creating reliable systems you can trust.
            </p>
            <div class="stats" id="stats">
              <div class="stat">
                <strong data-to="12" data-suf="+" class="font-sans">0</strong>
                <span class="font-mono">Partnership</span>
              </div>
              <div class="stat">
                <strong data-to="50" data-suf="+" class="font-sans">0</strong>
                <span class="font-mono">Projects Delivered</span>
              </div>
              <div class="stat">
                <strong data-to="5" data-suf="+" class="font-sans">0</strong>
                <span class="font-mono">Years Experience</span>
              </div>
              <div class="stat">
                <strong data-static="24/7" class="font-sans">24/7</strong>
                <span class="font-mono">Support Available</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3D Horizontal Rail -->
        <div class="rail" id="rail">
          <div class="track" id="track">
            <!-- Lead Panel -->
            <div class="panel lead" id="lead">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/5 text-xs font-mono text-muted mb-4 backdrop-blur-sm">
                <span>Engineering & Leadership</span>
              </div>
              <h2 class="font-sans">Built by this team</h2>
              <p class="font-sans text-muted">Real products, real impact. Here is the engineering collective shipping scalable systems together.</p>
              <span class="ours font-sans">
                This is Ours!
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-6">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </span>
            </div>

            <!-- Member Cards -->
            {teamMembers.map((member, i) => {
              const initials = member.name
                .split(" ")
                .filter(x => /^[A-Z]/.test(x))
                .slice(0, 2)
                .map(x => x[0])
                .join("");

              return (
                <button
                  type="button"
                  class="card panel"
                  style={`--h: ${member.hue};`}
                  aria-label={`${member.name}, ${member.role}`}
                  data-index={i}
                >
                  <div class="art">
                    <div class="blob b1"></div>
                    <div class="blob b2"></div>
                    <span class="ini select-none font-sans">{initials}</span>
                    <img 
                      src={member.image} 
                      alt={member.name} 
                      draggable="false"
                      class="photo"
                      loading="lazy"
                      decoding="async"
                      width="370"
                      height="300"
                    />
                  </div>
                  <div class="info">
                    <h3 class="font-sans">{member.name}</h3>
                    <span class="role font-mono">{member.role}</span>
                    <p class="font-sans">{member.bio}</p>
                  </div>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Interactive HUD at Bottom -->
        <div class="hud" id="hud">
          <div class="who font-sans" id="who" aria-live="polite">
            {teamMembers.map((member, i) => (
              <div style={i === 0 ? "opacity: 1;" : "opacity: 0; transform: translateY(100%);"}>
                <b class="font-sans">{member.name}</b>
                <span class="font-mono">{member.role}</span>
              </div>
            ))}
          </div>
          <div class="bar"><i id="barfill"></i></div>
          <div class="count font-mono" id="count"><b>01</b> / {String(teamMembers.length).padStart(2, '0')}</div>
          <div class="arrows">
            <button id="prev" aria-label="Previous person" type="button">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            </button>
            <button id="next" aria-label="Next person" type="button">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
          </div>
        </div>
        <div class="hint font-mono select-none" id="hint">Scroll, use arrow keys, or click a card</div>
      </div>
    </section>

    <!-- Footer -->
    <Footer />
  </main>
</MainLayout>

<style>
  :root {
    --hue: 228;
    --team-bg: #000000;
    --team-surface: #0a0d18;
    --team-ink: #f8fafc;
    --team-mute: #94a3b8;
    --team-line: rgba(255, 255, 255, 0.12);
  }

  html.light {
    --team-bg: #ffffff;
    --team-surface: #ffffff;
    --team-ink: #090d16;
    --team-mute: #475569;
    --team-line: rgba(0, 0, 0, 0.1);
  }

  .team-track {
    position: relative;
    height: 720vh;
    background: var(--team-bg);
    color: var(--team-ink);
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .stage-glow {
    position: absolute;
    top: 0;
    bottom: -20%;
    left: -20%;
    right: -20%;
    z-index: -2;
    background:
      radial-gradient(40% 40% at var(--gx, 70%) var(--gy, 40%), hsl(var(--hue) 85% 58% / 0.28), transparent 70%),
      radial-gradient(35% 35% at 15% 85%, hsl(calc(var(--hue) + 60) 80% 55% / 0.14), transparent 70%);
    will-change: transform;
    pointer-events: none;
  }

  html.light .stage-glow {
    background:
      radial-gradient(40% 40% at var(--gx, 70%) var(--gy, 40%), hsl(var(--hue) 85% 65% / 0.16), transparent 70%),
      radial-gradient(35% 35% at 15% 85%, hsl(calc(var(--hue) + 60) 80% 65% / 0.10), transparent 70%);
  }

  .stage-grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
    pointer-events: none;
    background-image:
      linear-gradient(var(--team-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--team-line) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%, 100% 12.5vh;
    -webkit-mask-image: radial-gradient(70% 70% at 50% 50%, #000, transparent);
    mask-image: radial-gradient(70% 70% at 50% 50%, #000, transparent);
  }

  .stage-ghost {
    position: absolute;
    left: 0;
    bottom: 8vh;
    white-space: nowrap;
    z-index: -1;
    font-size: clamp(80px, 18vw, 280px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.08);
    will-change: transform;
    pointer-events: none;
    transform: translate3d(10vw, 0, 0);
  }

  html.light .stage-ghost {
    -webkit-text-stroke: 1px rgba(0, 0, 0, 0.06);
  }

  /* Intro Layer */
  .intro {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 5vw;
    align-items: center;
    padding: 0 6vw;
    will-change: transform, opacity;
    z-index: 10;
  }

  .side {
  }

  .eyebrow {
    margin: 0 0 3vh;
    color: var(--team-mute);
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .eyebrow-line {
    display: block;
    width: 44px;
    height: 1px;
    background: var(--team-mute);
    transform-origin: left;
    transform: scaleX(var(--e, 0));
  }

  .title {
    margin: 0;
    font-size: clamp(36px, 5.8vw, 92px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--team-ink);
  }

  :global(.title .m) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  :global(.title .w) {
    display: inline-block;
    transform-origin: 0% 100%;
    will-change: transform, opacity;
  }

  .side p {
    margin: 0 0 4vh;
    color: var(--team-mute);
    font-size: clamp(14px, 1.2vw, 18px);
    line-height: 1.6;
    max-width: 46ch;
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--team-line);
  }

  .stat {
    padding: 2.2vh 0;
    border-bottom: 1px solid var(--team-line);
  }

  .stat:nth-child(odd) {
    padding-right: 20px;
    border-right: 1px solid var(--team-line);
  }

  .stat:nth-child(even) {
    padding-left: 24px;
  }

  .stat strong {
    display: block;
    font-size: clamp(30px, 3.8vw, 56px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--team-ink);
  }

  .stat span {
    color: var(--team-mute);
    font-size: 13px;
  }

  /* Rail */
  .rail {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
    z-index: 10;
  }

  .track {
    display: flex;
    align-items: center;
    gap: 3vw;
    will-change: transform;
    padding: 0 4vw;
    perspective: 1400px;
  }

  .panel {
    flex: none;
    pointer-events: auto;
  }

  .lead {
    width: min(86vw, 480px);
    padding-right: 2vw;
  }

  .lead h2 {
    margin: 0 0 2vh;
    font-size: clamp(32px, 4.4vw, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--team-ink);
  }

  .lead p {
    margin: 0 0 3.5vh;
    color: var(--team-mute);
    line-height: 1.6;
    font-size: clamp(14px, 1.1vw, 17px);
    max-width: 40ch;
  }

  .lead .ours {
    font-size: clamp(26px, 3.4vw, 48px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    display: inline-flex;
    gap: 14px;
    align-items: center;
    color: var(--team-ink);
  }

  .lead .ours svg {
    animation: nudge 1.6s ease-in-out infinite;
  }

  @keyframes nudge {
    50% { transform: translateX(8px); }
  }

  /* 3D Cards */
  .card {
    width: min(78vw, 370px);
    height: min(65vh, 540px);
    border-radius: 24px;
    background: var(--team-surface);
    border: 1px solid var(--team-line);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: pointer;
    position: relative;
    text-align: left;
    padding: 0;
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.25);
  }

  html.light .card {
    box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.08);
  }

  .card:hover {
    border-color: hsl(var(--h) 80% 68% / 0.8);
  }

  .art {
    position: relative;
    flex: 1 1 54%;
    min-height: 0;
    overflow: hidden;
    background: linear-gradient(160deg, hsl(var(--h) 75% 26%), hsl(calc(var(--h) + 40) 75% 12%));
  }

  html.light .art {
    background: linear-gradient(160deg, hsl(var(--h) 80% 90%), hsl(calc(var(--h) + 40) 80% 82%));
  }

  .art .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(4px);
    will-change: transform;
  }

  .art .b1 {
    width: 75%;
    aspect-ratio: 1;
    left: -15%;
    top: -10%;
    background: hsl(calc(var(--h) + 30) 90% 70% / 0.45);
  }

  .art .b2 {
    width: 60%;
    aspect-ratio: 1;
    right: -12%;
    bottom: -18%;
    background: hsl(calc(var(--h) - 30) 80% 20% / 0.5);
  }

  .art .ini {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(64px, 9vw, 110px);
    font-weight: 800;
    letter-spacing: -0.06em;
    color: rgba(255, 255, 255, 0.15);
    will-change: transform;
    pointer-events: none;
    z-index: 1;
  }

  html.light .art .ini {
    color: rgba(0, 0, 0, 0.08);
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
    z-index: 2;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.2));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
    pointer-events: none;
  }

  .card:hover .photo {
    transform: scale(1.05) translateY(-4px);
    filter: drop-shadow(0 16px 24px rgba(0, 0, 0, 0.32));
  }

  .info {
    padding: 20px 22px 24px;
    background: var(--team-surface);
  }

  .info h3 {
    margin: 0 0 6px;
    font-size: clamp(19px, 1.6vw, 23px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--team-ink);
  }

  .role {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 12px;
    padding: 3px 10px;
    border-radius: 99px;
    background: hsl(var(--h) 60% 60% / 0.16);
    color: hsl(var(--h) 90% 82%);
  }

  html.light .role {
    background: hsl(var(--h) 80% 92%);
    color: hsl(var(--h) 80% 30%);
  }

  .info p {
    margin: 0;
    color: var(--team-mute);
    font-size: 13px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* HUD */
  .hud {
    position: absolute;
    left: 6vw;
    right: 6vw;
    bottom: max(3.5vh, 18px);
    display: flex;
    align-items: center;
    gap: 20px;
    will-change: opacity, transform;
    z-index: 20;
  }

  .who {
    min-width: 0;
    flex: 0 1 280px;
    overflow: hidden;
    height: 2.8em;
    position: relative;
  }

  .who div {
    position: absolute;
    inset: 0;
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.4s ease;
    font-size: 13px;
    line-height: 1.35;
  }

  .who div b {
    display: block;
    font-weight: 700;
    font-size: 15px;
    color: var(--team-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .who div span {
    color: var(--team-mute);
    font-size: 12px;
  }

  .bar {
    flex: 1;
    height: 2px;
    background: var(--team-line);
    position: relative;
    border-radius: 2px;
  }

  .bar i {
    position: absolute;
    inset: 0;
    transform-origin: left;
    transform: scaleX(0);
    background: hsl(var(--hue) 90% 70%);
    border-radius: 2px;
  }

  .count {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    color: var(--team-mute);
    min-width: 60px;
    text-align: right;
  }

  .count b {
    color: var(--team-ink);
  }

  .arrows {
    display: flex;
    gap: 8px;
  }

  .arrows button {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--team-line);
    background: transparent;
    color: var(--team-ink);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.25s, border-color 0.25s;
  }

  .arrows button:hover {
    background: hsl(var(--hue) 80% 60% / 0.2);
    border-color: hsl(var(--hue) 80% 70%);
  }

  .hint {
    position: absolute;
    top: max(3.5vh, 20px);
    right: 6vw;
    color: var(--team-mute);
    font-size: 12px;
    opacity: var(--hint, 1);
    z-index: 20;
    contain: layout paint;
  }

  @media (max-width: 820px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 2.5vh;
      align-content: center;
      padding: 0 24px;
    }
    .intro-headline {
      min-height: 195px;
    }
    .side {
    }
    .side p {
      margin-bottom: 2.5vh;
      font-size: 14px;
    }
    .stat {
      padding: 1.4vh 0;
    }
    .hud {
      left: 20px;
      right: 20px;
      gap: 12px;
    }
    .who {
      display: none;
    }
    .hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lead .ours svg {
      animation: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  (function() {
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const inout = (t: number) => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    const section = $("team");
    const track = $("track");
    const intro = $("intro");
    const glow = $("glow");
    const ghost = $("ghost");
    const who = $("who");
    const barfill = $("barfill");
    const count = $("count");
    const hud = $("hud");
    const hint = $("hint");
    const eyebrow = $("eyebrow");
    const lede = $("lede");
    const stats = $("stats");
    const lead = $("lead");
    const stageEl = $("team-stage");

    if (!section || !track || !intro || !glow || !ghost || !who || !barfill || !count || !hud || !hint || !eyebrow || !lede || !stats || !lead || !stageEl) {
      return;
    }

    const wEls = Array.from(document.querySelectorAll<HTMLElement>(".title .w"));

    // Select pre-rendered cards
    const cardButtons = Array.from(track.querySelectorAll<HTMLButtonElement>(".card"));
    const whoEls = Array.from(who.querySelectorAll<HTMLElement>("div"));
    const statEls = Array.from(stats.querySelectorAll<HTMLElement>("strong[data-to]"));
    const statCards = Array.from(stats.children) as HTMLElement[];

    const cardData = cardButtons.map((b) => {
      const b1 = b.querySelector<HTMLElement>(".b1");
      const b2 = b.querySelector<HTMLElement>(".b2");
      const ini = b.querySelector<HTMLElement>(".ini");
      const photo = b.querySelector<HTMLElement>(".photo");
      const hVal = b.style.getPropertyValue("--h") || "228";
      return {
        el: b,
        b1,
        b2,
        ini,
        photo,
        hue: parseFloat(hVal) || 228
      };
    });

    const RS = 0.14; // rail start
    const RE = 0.90; // rail end
    const LS = 0.91; // leave start

    let vw = window.innerWidth;
    let vh = window.innerHeight;
    let startX = 0;
    let endX = 0;
    let centers: number[] = [];
    let leadC = 0;

    function measure() {
      vw = window.innerWidth;
      vh = window.innerHeight;
      if (!lead) return;
      leadC = lead.offsetLeft + lead.offsetWidth / 2;
      centers = cardButtons.map(c => c.offsetLeft + c.offsetWidth / 2);
      startX = vw * 1.02;
      endX = vw / 2 - (centers[centers.length - 1] || 0);
    }

    function xForRail(r: number) {
      return lerp(startX, endX, r);
    }

    function railFor(c: number) {
      return (startX - (vw / 2 - c)) / (startX - endX);
    }

    let target = 0;
    let cur = 0;
    let active = -1;
    let hue = 228;
    let hueT = 228;
    let ready = false;
    let isTicking = false;

    function read() {
      if (!section) return;
      const r = section.getBoundingClientRect();
      target = clamp(-r.top / (r.height - vh));
      scheduleTick();
    }

    function scheduleTick() {
      if (!isTicking) {
        isTicking = true;
        requestAnimationFrame(tick);
      }
    }

    function goTo(i: number) {
      if (!section || !cardButtons.length) return;
      i = clamp(i, 0, cardButtons.length - 1);
      const p = RS + clamp(railFor(centers[i])) * (RE - RS);
      const top = section.getBoundingClientRect().top + window.scrollY;
      const targetY = top + p * (section.offsetHeight - vh);

      const lenis = (window as any).lenis;
      if (lenis && typeof lenis.scrollTo === "function") {
        lenis.scrollTo(targetY, { duration: 1.2 });
      } else {
        window.scrollTo({ top: targetY, behavior: "smooth" });
      }
      scheduleTick();
    }

    cardButtons.forEach((b, i) => {
      b.addEventListener("click", () => goTo(i));
    });

    const nextBtn = $("next");
    const prevBtn = $("prev");
    if (nextBtn) {
      nextBtn.onclick = () => goTo(Math.max(active, -1) + 1);
    }
    if (prevBtn) {
      prevBtn.onclick = () => goTo(active - 1);
    }

    window.addEventListener("keydown", (e) => {
      if (!section) return;
      const r = section.getBoundingClientRect();
      if (r.top > vh * 0.5 || r.bottom < vh * 0.5) return;
      if (e.key === "ArrowRight") {
        e.preventDefault();
        nextBtn?.click();
      }
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        prevBtn?.click();
      }
    });

    function stage_set(h: number) {
      stageEl.style.setProperty("--hue", h.toFixed(1));
    }

    // GSAP First-Load Word Show Entrance Animation
    const isReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function playEntrance() {
      if (isReduced) {
        statEls.forEach((el) => {
          el.textContent = (el.dataset.to || "0") + (el.dataset.suf || "");
        });
        return;
      }

      const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

      tl.from(eyebrow, {
        opacity: 0,
        x: -20,
        duration: 0.75,
        ease: "power3.out",
      }, 0.05)
      .from(wEls, {
        yPercent: 100,
        rotate: 3,
        opacity: 0,
        duration: 0.95,
        stagger: 0.04,
        ease: "power4.out",
      }, 0.12)
      .from(lede, {
        opacity: 0,
        y: 16,
        duration: 0.8,
        ease: "power3.out",
      }, 0.35)
      .from(statCards, {
        opacity: 0,
        y: 18,
        duration: 0.75,
        stagger: 0.06,
        ease: "power3.out",
      }, 0.4)
      .from([hud, hint], {
        opacity: 0,
        y: 14,
        duration: 0.7,
        ease: "power3.out",
      }, 0.65);

      // Dynamic count-up for numbers
      statEls.forEach((el, i) => {
        const toNum = parseFloat(el.dataset.to || "0");
        const suf = el.dataset.suf || "";
        const obj = { val: 0 };
        gsap.to(obj, {
          val: toNum,
          duration: 1.4,
          delay: 0.5 + i * 0.08,
          ease: "power2.out",
          onUpdate: () => {
            el.textContent = Math.round(obj.val) + suf;
          },
        });
      });

      // Ambient Aurora glow bloom
      gsap.fromTo(glow, 
        { scale: 0.7, opacity: 0 },
        { scale: 1, opacity: 1, duration: 1.5, ease: "power2.out" }
      );
    }

    function render(p: number) {
      glow.style.setProperty("--gx", `${70 - p * 40}%`);
      glow.style.setProperty("--gy", `${40 + Math.sin(p * 6) * 18}%`);

      /* IN-PROGRESS (Intro slides out & fades as scroll enters the cards) */
      const io = inout(clamp((p - 0.015) / (RS - 0.015 + 0.05)));
      intro.style.opacity = String(1 - io);
      intro.style.transform = `translate3d(0, ${-io * 14}vh, 0) scale(${1 - io * 0.06})`;
      intro.style.pointerEvents = io > 0.9 ? "none" : "auto";
      intro.style.visibility = io >= 1 ? "hidden" : "visible";

      const rp = clamp((p - RS) / (RE - RS));
      const x = xForRail(rp);
      track.style.transform = `translate3d(${x}px, 0, 0)`;
      ghost.style.transform = `translate3d(${-p * vw * 1.6 + vw * 0.1}px, 0, 0)`;

      const l = clamp((p - LS) / (1 - LS)); // LEAVE
      let best = 1e9;
      let bi = -1;

      // Lead panel
      const ld = (x + leadC - vw / 2) / vw;
      lead.style.opacity = String(clamp(1 - Math.abs(ld) * 1.1) * (1 - l));
      lead.style.transform = `translateX(${ld * -30}px) translateY(${-l * 8}vh)`;

      // Cards
      cardData.forEach((cd, i) => {
        const c = cd.el;
        const d = (x + centers[i] - vw / 2) / vw;
        const a = Math.min(Math.abs(d), 1.2);
        if (Math.abs(d) < best) {
          best = Math.abs(d);
          bi = i;
        }
        const focus = 1 - Math.min(a * 1.8, 1);
        const li = ease(clamp(l * 1.9 - (cardData.length - 1 - i) * 0.07));
        const sc = lerp(0.82, 1, focus) * (1 - li * 0.25);
        c.style.transform = `translate3d(0, ${lerp(26, 0, focus) - li * 22}px, 0) rotateY(${d * -22}deg) scale(${sc})`;
        c.style.opacity = String(clamp(lerp(0.35, 1, focus) * (1 - li)));
        c.style.filter = li > 0 ? `blur(${li * 10}px)` : "none";

        if (cd.ini) cd.ini.style.transform = `translate3d(${d * -70}px, 0, 0)`;
        if (cd.b1) cd.b1.style.transform = `translate3d(${d * -120}px, ${d * 40}px, 0)`;
        if (cd.b2) cd.b2.style.transform = `translate3d(${d * 160}px, ${d * -30}px, 0)`;
      });

      // Active person HUD
      let ni = rp <= 0.001 ? -1 : bi;
      if (Math.abs(ld) < best) ni = -1;
      if (ni !== active) {
        active = ni;
        whoEls.forEach((w, i) => {
          const on = i === active;
          w.style.opacity = on ? "1" : "0";
          w.style.transform = `translateY(${on ? 0 : i < active ? -100 : 100}%)`;
        });
        hueT = active >= 0 ? cardData[active].hue : 228;
        count.innerHTML = `<b>${String(Math.max(active + 1, 0)).padStart(2, "0")}</b> / ${String(cardData.length).padStart(2, "0")}`;
      }
      const dh = ((hueT - hue + 540) % 360) - 180;
      hue = (hue + dh * 0.06 + 360) % 360;
      stage_set(hue);
      barfill.style.transform = `scaleX(${rp})`;

      /* LEAVE */
      hud.style.opacity = String(clamp(1 - l * 2.4));
      hud.style.transform = `translate3d(0, ${l * 40}px, 0)`;
      hint.style.setProperty("--hint", String(clamp(1 - p * 14) * (1 - l)));
      ghost.style.opacity = String(1 - l);
      glow.style.opacity = String(1 - l * 0.85);
    }

    function tick() {
      cur += (target - cur) * 0.12;
      const diff = Math.abs(target - cur);
      if (diff < 0.0001) {
        cur = target;
      }
      render(cur);

      if (Math.abs(target - cur) > 0.0001) {
        requestAnimationFrame(tick);
      } else {
        isTicking = false;
      }
    }

    function init() {
      measure();
      read();
      cur = target;
      render(cur);
      if (!ready) {
        ready = true;
        playEntrance();
      }
    }

    const lenis = (window as any).lenis;
    if (lenis && typeof lenis.on === "function") {
      lenis.on("scroll", read);
    }
    window.addEventListener("scroll", read, { passive: true });
    window.addEventListener("resize", () => {
      measure();
      read();
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(measure);
    }
  })();
</script>
